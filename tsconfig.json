{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    // rootDir "." bilinçli: çıktı dist/src/ altına düşer, package.json'daki
    // "bin"/"main" alanları da dist/src/... yollarını gösterir.
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false
  },
  // scripts/ altındakiler .mjs; tsc'nin işi değiller, bilerek dışarıda.
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist", "scripts"]
}
