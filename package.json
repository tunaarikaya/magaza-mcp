{
  "name": "magaza-mcp",
  "version": "0.2.1",
  "description": "App Store Connect ve Google Play'i tek MCP sunucusunda birleştirir. Yapay zekâ asistanın iki mağazayı da yönetsin.",
  "type": "module",
  "bin": {
    "magaza-mcp": "dist/src/cli.js"
  },
  "main": "dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "spec",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tunaarikaya/magaza-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/tunaarikaya/magaza-mcp/issues"
  },
  "homepage": "https://github.com/tunaarikaya/magaza-mcp#readme",
  "scripts": {
    "temizle": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run temizle && tsc && node scripts/kopyala-katalog.mjs",
    "dev": "tsc --watch",
    "kontrol": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "spec:guncelle": "node scripts/spec-guncelle.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "app-store-connect",
    "google-play",
    "android-publisher",
    "testflight",
    "claude",
    "antigravity",
    "cursor",
    "ios",
    "android",
    "turkce"
  ],
  "author": "tunaarikaya",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.6.0"
  }
}
